index=soc_lab sourcetype="soc:windows:auth:csv" EventCode=4625
| sort 0 _time EventRecordID
| streamstats time_window=30m count AS failures dc(Account_Name) AS accounts by Source_Network_Address
| where accounts>=10 AND failures>=10
| table _time Source_Network_Address failures accounts EventRecordID
| where _time>=relative_time(now(),"-5m@m")
